rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins: a document admins/<uid> marks that person as an admin.
    // Created by hand in the Firebase console; nobody can create one from the app.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Access record { challenge, all, start, end, endAt } that is still valid:
    // all access without an end date, or any pass until endAt (milliseconds).
    function activeAt(path) {
      return exists(path) && (
        (get(path).data.all == true && get(path).data.endAt == null)
        || (get(path).data.endAt != null && get(path).data.endAt >= request.time.toMillis())
      );
    }

    // Access is given to an account (access/<uid>) or to an email before the person
    // signs up (accessByEmail/<email>); the email one only counts once the email is verified.
    function hasAccess(uid) {
      return activeAt(/databases/$(database)/documents/access/$(uid))
        || (request.auth.token.email_verified == true
            && activeAt(/databases/$(database)/documents/accessByEmail/$(request.auth.token.email.lower())));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Only admins give or remove access; each person can see their own.
    match /access/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // Access waiting for an email address; its owner can read it once their email is verified.
    match /accessByEmail/{email} {
      allow get: if request.auth != null && (isAdmin()
        || (request.auth.token.email_verified == true && request.auth.token.email.lower() == email));
      allow list, write: if isAdmin();
    }

    // Email and name, so an admin can find someone who paid.
    match /directory/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Each person's own log: only they can read or change it.
    // New entries need access (a paid challenge, or all access).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /days/{day} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && hasAccess(uid);
      }
    }

    // Shared copies, only while someone has sharing turned on.
    // Anyone signed in can open a copy if they know its code,
    // but nobody can list codes, and only the owner can change it.
    match /shares/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;

      match /days/{day} {
        allow get: if request.auth != null;
        allow list, write: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(code)).data.owner == request.auth.uid;
      }
    }

    // Groups: anyone signed in can open a group if they know its code (to join),
    // but nobody can list groups. Only members can see the members' insights.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;

      match /members/{memberId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && exists(/databases/$(database)/documents/groups/$(code));
        allow delete: if request.auth != null
          && (request.auth.uid == memberId
              || get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid);
      }
    }
  }
}

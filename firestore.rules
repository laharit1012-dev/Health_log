rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's own log: only they can read or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /days/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared copies, only while someone has sharing turned on.
    // Anyone signed in can open a copy if they know its code,
    // but nobody can list codes, and only the owner can change it.
    match /shares/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;

      match /days/{day} {
        allow get: if request.auth != null;
        allow list, write: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(code)).data.owner == request.auth.uid;
      }
    }

    // Groups: anyone signed in can open a group if they know its code (to join),
    // but nobody can list groups. Only members can see the members' insights.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;

      match /members/{memberId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && exists(/databases/$(database)/documents/groups/$(code));
        allow delete: if request.auth != null
          && (request.auth.uid == memberId
              || get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid);
      }
    }
  }
}
